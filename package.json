{
  "name": "shop-harness-workshop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "node scripts/verify.mjs --only typecheck",
    "lint": "node scripts/verify.mjs --only lint",
    "test": "vitest run",
    "build": "node scripts/verify.mjs --only build",
    "db:reset": "node apps/api/scripts/db-reset.ts",
    "orders:simulate": "node apps/api/scripts/orders-simulate.ts",
    "mcp:db": "node tools/mcp-db/src/server.ts",
    "viewer": "node viewer.mjs",
    "grade": "node tools/grader/src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "allowScripts": {
    "fsevents": false
  }
}
